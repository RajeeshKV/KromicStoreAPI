# KromicStore Development Environment Variables
# Copy to .env.local and fill with your development values

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/kromicstore_dev
DB_CONNECTION_POOL_MIN=5
DB_CONNECTION_POOL_MAX=25
DB_CONNECTION_TIMEOUT_SECONDS=30
DB_IDLE_TIMEOUT_SECONDS=300
DB_MAX_AGE_SECONDS=1800

# Authentication & JWT
JWT_SECRET=your-dev-jwt-secret-at-least-32-chars-long-change-this-value-now
JWT_AUTHORITY=https://auth.example.com
JWT_AUDIENCE=kromic-store-api
JWT_EXPIRATION_MINUTES=60
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true

# Security & Encryption
SECURITY_ENCRYPTION_KEY=your-dev-encryption-key-at-least-32-chars-long-change-now
SECURITY_REQUIRE_HTTPS=false
CORS_ALLOW_ANY_ORIGIN=true
CORS_ALLOW_CREDENTIALS=true

# API Settings
API_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:3000
SWAGGER_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# Redis Cache
REDIS_URL=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT_MS=5000
CACHE_TTL_PRODUCTS_MINUTES=60
CACHE_TTL_ORDERS_MINUTES=5
CACHE_TTL_CONFIG_MINUTES=30

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
RATE_LIMIT_BY_PLAN={"starter":100,"professional":500,"enterprise":5000}
RATE_LIMIT_CACHE_KEY_PREFIX=rate_limit

# Logging
LOG_LEVEL=Debug
LOG_OUTPUT_FORMAT=json
LOG_FILE_PATH=/var/log/kromic-store.log
LOG_FILE_SIZE_MB=100
LOG_FILES_TO_KEEP=10
CORRELATION_ID_ENABLED=true

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=rzp_test_1234567890
RAZORPAY_KEY_SECRET=your_test_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret
RAZORPAY_TIMEOUT_SECONDS=30
RAZORPAY_RETRY_ENABLED=true
RAZORPAY_CIRCUIT_BREAKER_THRESHOLD=5

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/google/callback
GOOGLE_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
GOOGLE_USER_INFO_ENDPOINT=https://www.googleapis.com/oauth2/v2/userinfo

# Cloudinary Media Service
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_BASE_URL=https://api.cloudinary.com
CLOUDINARY_FOLDER_PATH=kromic-store-dev
CLOUDINARY_QUALITY=auto
CLOUDINARY_MAX_FILE_SIZE_MB=100

# Brevo Email Service
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=dev@kromicstore.local
BREVO_SENDER_NAME=KromicStore Dev
BREVO_BASE_URL=https://api.brevo.com
BREVO_API_VERSION=v3
BREVO_WELCOME_EMAIL_TEMPLATE_ID=1
BREVO_ORDER_CONFIRMATION_TEMPLATE_ID=2
BREVO_SHIPMENT_NOTIFICATION_TEMPLATE_ID=3
BREVO_PAYMENT_FAILURE_TEMPLATE_ID=4

# Hangfire Background Jobs
HANGFIRE_ENABLED=true
HANGFIRE_WORKER_COUNT=4
HANGFIRE_QUEUES=default,webhooks,scheduled
HANGFIRE_SUCCESS_JOB_EXPIRY_MINUTES=60
HANGFIRE_FAILED_JOB_EXPIRY_DAYS=7

# Application Settings
APPLICATION_INSTANCE_ID=local-dev-instance
MAX_UPLOAD_SIZE_MB=100
SESSION_TIMEOUT_MINUTES=30
PAGINATION_DEFAULT_PAGE_SIZE=20
PAGINATION_MAX_PAGE_SIZE=100

# Tenant Settings
TENANT_TRIAL_DURATION_DAYS=14
TENANT_MAX_USERS_STARTER=5
TENANT_MAX_USERS_PROFESSIONAL=50
TENANT_MAX_PRODUCTS_STARTER=100
TENANT_MAX_PRODUCTS_PROFESSIONAL=1000
TENANT_MAX_API_CALLS_STARTER=10000
TENANT_MAX_API_CALLS_PROFESSIONAL=100000

# Subscription Plans
SUBSCRIPTION_PLAN_STARTER_PRICE=9.99
SUBSCRIPTION_PLAN_PROFESSIONAL_PRICE=29.99
SUBSCRIPTION_PLAN_ENTERPRISE_PRICE=99.99
SUBSCRIPTION_PLAN_CURRENCY=USD

# External Services
EXTERNAL_SERVICE_TIMEOUT_SECONDS=30
EXTERNAL_SERVICE_MAX_RETRIES=4
EXTERNAL_SERVICE_RETRY_DELAYS_MS=[100,1000,10000,30000]
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_SECONDS=30

# Monitoring (Application Insights)
MONITORING_ENABLED=false
MONITORING_INSTRUMENTATION_KEY=
MONITORING_LOG_LEVEL=Information
MONITORING_RESPONSE_TIME_THRESHOLD_MS=500
MONITORING_DB_QUERY_THRESHOLD_MS=100
