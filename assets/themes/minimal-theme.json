{
  "id": "minimal",
  "slug": "minimal",
  "name": "Minimal",
  "description": "Clean, modern storefront with a minimalist design approach",
  "version": "1.0.0",
  "defaultPages": [
    {
      "name": "Home",
      "slug": "index",
      "layoutType": "default",
      "displayOrder": 0,
      "sections": [
        {
          "name": "Hero Banner",
          "displayOrder": 0,
          "components": [
            {
              "type": "hero-banner",
              "props": {
                "title": "Welcome to Our Store",
                "subtitle": "Discover our collection",
                "backgroundColor": "#FFFFFF",
                "textColor": "#000000"
              }
            }
          ]
        },
        {
          "name": "Featured Products",
          "displayOrder": 1,
          "components": [
            {
              "type": "product-grid",
              "props": {
                "columns": 3,
                "itemsPerPage": 6,
                "showPrice": true,
                "showRating": true
              }
            }
          ]
        },
        {
          "name": "Footer",
          "displayOrder": 2,
          "components": [
            {
              "type": "footer",
              "props": {
                "backgroundColor": "#F5F5F5",
                "textColor": "#333333",
                "copyrightText": "© 2024 Our Store. All rights reserved."
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Shop",
      "slug": "shop",
      "layoutType": "grid",
      "displayOrder": 1,
      "sections": [
        {
          "name": "Filters & Products",
          "displayOrder": 0,
          "components": [
            {
              "type": "category-filter",
              "props": {
                "showCategories": true,
                "showPriceRange": true,
                "maxPriceRange": 10000
              }
            },
            {
              "type": "product-grid",
              "props": {
                "columns": 3,
                "sortBy": "featured",
                "showPrice": true,
                "showAddToCart": true
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Contact",
      "slug": "contact",
      "layoutType": "default",
      "displayOrder": 2,
      "sections": [
        {
          "name": "Contact Form",
          "displayOrder": 0,
          "components": [
            {
              "type": "contact-form",
              "props": {
                "showName": true,
                "showEmail": true,
                "showMessage": true,
                "submitButtonText": "Send Message"
              }
            }
          ]
        }
      ]
    }
  ],
  "defaultBranding": {
    "primaryColor": "#000000",
    "secondaryColor": "#FFFFFF",
    "accentColor": "#F0F0F0",
    "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "fontSize": "16px",
    "logoUrl": null,
    "faviconUrl": null
  },
  "defaultNavigation": [
    {
      "label": "Home",
      "url": "/",
      "displayOrder": 0
    },
    {
      "label": "Shop",
      "url": "/shop",
      "displayOrder": 1
    },
    {
      "label": "Contact",
      "url": "/contact",
      "displayOrder": 2
    }
  ],
  "defaultFooter": [
    {
      "section": "Quick Links",
      "items": [
        { "label": "Home", "url": "/" },
        { "label": "Shop", "url": "/shop" },
        { "label": "About", "url": "/about" },
        { "label": "Contact", "url": "/contact" }
      ]
    },
    {
      "section": "Legal",
      "items": [
        { "label": "Privacy Policy", "url": "/privacy" },
        { "label": "Terms of Service", "url": "/terms" },
        { "label": "Shipping Policy", "url": "/shipping" }
      ]
    },
    {
      "section": "Customer Service",
      "items": [
        { "label": "FAQ", "url": "/faq" },
        { "label": "Support", "url": "/support" },
        { "label": "Returns", "url": "/returns" }
      ]
    }
  ]
}
