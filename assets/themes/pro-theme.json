      "displayOrder": 1,
      "submenu": [
        { "label": "New Arrivals", "url": "/shop?sort=newest" },
        { "label": "Best Sellers", "url": "/shop?sort=bestsellers" },
        { "label": "Sale", "url": "/shop?collection=sale" }
      ]
    },
    {
      "label": "About",
      "url": "/about",
