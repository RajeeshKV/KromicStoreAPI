# KromicStore API - Render Deployment Environment Variables
# Copy this file to .env.render and fill in actual values before deployment

# ============================================
# REQUIRED ENVIRONMENT VARIABLES
# ============================================

# Database
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/kromicstore

# Redis Cache
# Format: host:port or redis://:password@host:port
REDIS_URL=localhost:6379

# JWT Authentication
JWT_AUTHORITY=https://your-auth-provider.com
JWT_AUDIENCE=kromic-store-api
JWT_SECRET=your-super-secret-jwt-signing-key-min-32-chars

# Encryption
ENCRYPTION_KEY=your-encryption-key-min-32-chars

# ============================================
# RAZORPAY PAYMENT GATEWAY
# ============================================

# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY=rzp_live_xxxxxxxxxxxx
RAZORPAY_SECRET=your_razorpay_api_secret

# ============================================
# GOOGLE OAUTH
# ============================================

# Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# CLOUDINARY MEDIA SERVICE
# ============================================

# Get from: https://cloudinary.com/console/c/account/credentials
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ============================================
# BREVO EMAIL SERVICE
# ============================================

# Get from: https://app.brevo.com/
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@kromicstore.com
BREVO_WELCOME_EMAIL_TEMPLATE_ID=1
BREVO_ORDER_CONFIRMATION_TEMPLATE_ID=2
BREVO_PAYMENT_SUCCESS_TEMPLATE_ID=3

# ============================================
# APPLICATION SETTINGS
# ============================================

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Logging level: Debug, Information, Warning, Error, Fatal
LOG_LEVEL=Information

# ============================================
# RENDER-SPECIFIC SETTINGS
# ============================================

# Port (set by Render, but can override)
PORT=8080

# Enable detailed logging for troubleshooting (set to false in production after verification)
ASPNETCORE_DETAILEDLOGGING=false

# ============================================
# OPTIONAL SETTINGS
# ============================================

# Application Insights (monitoring)
APPLICATION_INSIGHTS_KEY=your-app-insights-instrumentation-key

# CORS Origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://frontend.example.com,https://app.example.com

# ============================================
# NOTES
# ============================================
# 1. Never commit actual secrets to git
# 2. Use Render's environment variable management for sensitive values
# 3. Test all external service integrations before production deployment
# 4. Keep credentials secure and rotate regularly
# 5. Database backup credentials should be stored separately in Render backup settings
