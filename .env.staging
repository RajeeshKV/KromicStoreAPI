# KromicStore Staging Environment Variables
# Use for staging deployment - all values should come from secure configuration management

ASPNETCORE_ENVIRONMENT=Staging
ASPNETCORE_URLS=http://+:8080

# Database - Production-like PostgreSQL instance
DATABASE_URL=${STAGING_DATABASE_URL}
DB_CONNECTION_POOL_MIN=10
DB_CONNECTION_POOL_MAX=50
DB_CONNECTION_TIMEOUT_SECONDS=30
DB_IDLE_TIMEOUT_SECONDS=300
DB_MAX_AGE_SECONDS=1800

# Authentication & JWT
JWT_SECRET=${STAGING_JWT_SECRET}
JWT_AUTHORITY=https://auth.staging.kronmicstore.com
JWT_AUDIENCE=kromic-store-api-staging
JWT_EXPIRATION_MINUTES=60
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true

# Security & Encryption
SECURITY_ENCRYPTION_KEY=${STAGING_ENCRYPTION_KEY}
SECURITY_REQUIRE_HTTPS=true
CORS_ALLOW_ANY_ORIGIN=false
CORS_ALLOW_CREDENTIALS=true

# API Settings
API_BASE_URL=https://api.staging.kromicstore.com
FRONTEND_BASE_URL=https://app.staging.kromicstore.com
SWAGGER_ENABLED=false
CORS_ALLOWED_ORIGINS=https://app.staging.kromicstore.com

# Redis Cache - Staging instance
REDIS_URL=${STAGING_REDIS_URL}
REDIS_PASSWORD=${STAGING_REDIS_PASSWORD}
REDIS_DB=0
REDIS_TIMEOUT_MS=5000
CACHE_TTL_PRODUCTS_MINUTES=60
CACHE_TTL_ORDERS_MINUTES=5
CACHE_TTL_CONFIG_MINUTES=30

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BY_PLAN={"starter":100,"professional":500,"enterprise":5000}
RATE_LIMIT_CACHE_KEY_PREFIX=rate_limit_staging

# Logging
LOG_LEVEL=Information
LOG_OUTPUT_FORMAT=json
LOG_FILE_PATH=/var/log/kromic-store-staging.log
LOG_FILE_SIZE_MB=100
LOG_FILES_TO_KEEP=20
CORRELATION_ID_ENABLED=true

# Razorpay Payment Gateway - Test Mode for Staging
RAZORPAY_KEY_ID=${STAGING_RAZORPAY_KEY_ID}
RAZORPAY_KEY_SECRET=${STAGING_RAZORPAY_KEY_SECRET}
RAZORPAY_WEBHOOK_SECRET=${STAGING_RAZORPAY_WEBHOOK_SECRET}
RAZORPAY_TIMEOUT_SECONDS=30
RAZORPAY_RETRY_ENABLED=true
RAZORPAY_CIRCUIT_BREAKER_THRESHOLD=5

# Google OAuth - Staging Credentials
GOOGLE_CLIENT_ID=${STAGING_GOOGLE_CLIENT_ID}
GOOGLE_CLIENT_SECRET=${STAGING_GOOGLE_CLIENT_SECRET}
GOOGLE_REDIRECT_URI=https://api.staging.kromicstore.com/api/v1/auth/oauth/google/callback
GOOGLE_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
GOOGLE_USER_INFO_ENDPOINT=https://www.googleapis.com/oauth2/v2/userinfo

# Cloudinary Media Service
CLOUDINARY_CLOUD_NAME=${STAGING_CLOUDINARY_CLOUD_NAME}
CLOUDINARY_API_KEY=${STAGING_CLOUDINARY_API_KEY}
CLOUDINARY_API_SECRET=${STAGING_CLOUDINARY_API_SECRET}
CLOUDINARY_BASE_URL=https://api.cloudinary.com
CLOUDINARY_FOLDER_PATH=kromic-store-staging
CLOUDINARY_QUALITY=auto
CLOUDINARY_MAX_FILE_SIZE_MB=100

# Brevo Email Service - Staging Account
BREVO_API_KEY=${STAGING_BREVO_API_KEY}
BREVO_SENDER_EMAIL=noreply@staging.kromicstore.com
BREVO_SENDER_NAME=KromicStore Staging
BREVO_BASE_URL=https://api.brevo.com
BREVO_API_VERSION=v3
BREVO_WELCOME_EMAIL_TEMPLATE_ID=1
BREVO_ORDER_CONFIRMATION_TEMPLATE_ID=2
BREVO_SHIPMENT_NOTIFICATION_TEMPLATE_ID=3
BREVO_PAYMENT_FAILURE_TEMPLATE_ID=4

# Hangfire Background Jobs
HANGFIRE_ENABLED=true
HANGFIRE_WORKER_COUNT=8
HANGFIRE_QUEUES=default,webhooks,scheduled
HANGFIRE_SUCCESS_JOB_EXPIRY_MINUTES=60
HANGFIRE_FAILED_JOB_EXPIRY_DAYS=7

# Application Settings
APPLICATION_INSTANCE_ID=staging-instance-1
MAX_UPLOAD_SIZE_MB=100
SESSION_TIMEOUT_MINUTES=30
PAGINATION_DEFAULT_PAGE_SIZE=20
PAGINATION_MAX_PAGE_SIZE=100

# Tenant Settings
TENANT_TRIAL_DURATION_DAYS=14
TENANT_MAX_USERS_STARTER=5
TENANT_MAX_USERS_PROFESSIONAL=50
TENANT_MAX_PRODUCTS_STARTER=100
TENANT_MAX_PRODUCTS_PROFESSIONAL=1000
TENANT_MAX_API_CALLS_STARTER=10000
TENANT_MAX_API_CALLS_PROFESSIONAL=100000

# Subscription Plans
SUBSCRIPTION_PLAN_STARTER_PRICE=9.99
SUBSCRIPTION_PLAN_PROFESSIONAL_PRICE=29.99
SUBSCRIPTION_PLAN_ENTERPRISE_PRICE=99.99
SUBSCRIPTION_PLAN_CURRENCY=USD

# External Services
EXTERNAL_SERVICE_TIMEOUT_SECONDS=30
EXTERNAL_SERVICE_MAX_RETRIES=4
EXTERNAL_SERVICE_RETRY_DELAYS_MS=[100,1000,10000,30000]
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_SECONDS=30

# Monitoring (Application Insights)
MONITORING_ENABLED=true
MONITORING_INSTRUMENTATION_KEY=${STAGING_APPLICATION_INSIGHTS_KEY}
MONITORING_LOG_LEVEL=Information
MONITORING_RESPONSE_TIME_THRESHOLD_MS=500
MONITORING_DB_QUERY_THRESHOLD_MS=100
