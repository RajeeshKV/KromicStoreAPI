# KromicStore Production Environment Variables
# IMPORTANT: Never commit actual secrets. All values must come from secure secret management.
# Use: Render Secrets, AWS Secrets Manager, Azure Key Vault, or equivalent

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Database - Production PostgreSQL Instance
# Example: postgresql://user:password@prod-db.example.com:5432/kromicstore
DATABASE_URL=${PRODUCTION_DATABASE_URL}
DB_CONNECTION_POOL_MIN=20
DB_CONNECTION_POOL_MAX=100
DB_CONNECTION_TIMEOUT_SECONDS=30
DB_IDLE_TIMEOUT_SECONDS=300
DB_MAX_AGE_SECONDS=1800

# Authentication & JWT - Use strong, randomly generated secrets
JWT_SECRET=${PRODUCTION_JWT_SECRET}
JWT_AUTHORITY=https://auth.kromicstore.com
JWT_AUDIENCE=kromic-store-api
JWT_EXPIRATION_MINUTES=60
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true

# Security & Encryption
SECURITY_ENCRYPTION_KEY=${PRODUCTION_ENCRYPTION_KEY}
SECURITY_REQUIRE_HTTPS=true
CORS_ALLOW_ANY_ORIGIN=false
CORS_ALLOW_CREDENTIALS=true

# API Settings
API_BASE_URL=https://api.kromicstore.com
FRONTEND_BASE_URL=https://app.kromicstore.com
SWAGGER_ENABLED=false
# Use wildcard pattern to allow all subdomains: https://*.kromic.in
# Or specify exact origins: https://app.kromic.in,https://admin.kromic.in
# Include both HTTP and HTTPS for development/testing
CORS_ALLOWED_ORIGINS=https://*.kromic.in,http://*.kromic.in,https://kromicstoreapi.onrender.com,http://kromicstoreapi.onrender.com

# Redis Cache - Production Cluster
# Example: redis://user:password@prod-redis.example.com:6379
REDIS_URL=${PRODUCTION_REDIS_URL}
REDIS_PASSWORD=${PRODUCTION_REDIS_PASSWORD}
REDIS_DB=0
REDIS_TIMEOUT_MS=5000
CACHE_TTL_PRODUCTS_MINUTES=60
CACHE_TTL_ORDERS_MINUTES=5
CACHE_TTL_CONFIG_MINUTES=30

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BY_PLAN={"starter":100,"professional":500,"enterprise":5000}
RATE_LIMIT_CACHE_KEY_PREFIX=rate_limit_prod

# Logging
LOG_LEVEL=Information
LOG_OUTPUT_FORMAT=json
LOG_FILE_PATH=/var/log/kromic-store-prod.log
LOG_FILE_SIZE_MB=500
LOG_FILES_TO_KEEP=30
CORRELATION_ID_ENABLED=true

# Razorpay Payment Gateway - LIVE MODE
RAZORPAY_KEY_ID=${PRODUCTION_RAZORPAY_KEY_ID}
RAZORPAY_KEY_SECRET=${PRODUCTION_RAZORPAY_KEY_SECRET}
RAZORPAY_API_ENDPOINT=https://api.razorpay.com/v1
RAZORPAY_WEBHOOK_SECRET=${PRODUCTION_RAZORPAY_WEBHOOK_SECRET}
RAZORPAY_TIMEOUT_SECONDS=30
RAZORPAY_RETRY_ENABLED=true
RAZORPAY_CIRCUIT_BREAKER_THRESHOLD=5

# Google OAuth - Production Credentials
GOOGLE_CLIENT_ID=${PRODUCTION_GOOGLE_CLIENT_ID}
GOOGLE_CLIENT_SECRET=${PRODUCTION_GOOGLE_CLIENT_SECRET}
GOOGLE_REDIRECT_URI=https://api.kromicstore.com/api/v1/auth/oauth/google/callback
GOOGLE_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
GOOGLE_USER_INFO_ENDPOINT=https://www.googleapis.com/oauth2/v2/userinfo

# Cloudinary Media Service - Production Account
CLOUDINARY_CLOUD_NAME=${PRODUCTION_CLOUDINARY_CLOUD_NAME}
CLOUDINARY_API_KEY=${PRODUCTION_CLOUDINARY_API_KEY}
CLOUDINARY_API_SECRET=${PRODUCTION_CLOUDINARY_API_SECRET}
CLOUDINARY_BASE_URL=https://api.cloudinary.com
CLOUDINARY_FOLDER_PATH=kromic-store
CLOUDINARY_QUALITY=auto
CLOUDINARY_MAX_FILE_SIZE_MB=100

# Brevo Email Service - Production Account
BREVO_API_KEY=${PRODUCTION_BREVO_API_KEY}
BREVO_SENDER_EMAIL=noreply@kromicstore.com
BREVO_SENDER_NAME=KromicStore
BREVO_BASE_URL=https://api.brevo.com
BREVO_API_VERSION=v3
BREVO_TEMPLATE_ORDER_PLACED=${PRODUCTION_BREVO_TEMPLATE_ORDER_PLACED}
BREVO_TEMPLATE_ORDER_CONFIRMED=${PRODUCTION_BREVO_TEMPLATE_ORDER_CONFIRMED}
BREVO_TEMPLATE_ORDER_DISPATCHED=${PRODUCTION_BREVO_TEMPLATE_ORDER_DISPATCHED}
BREVO_WELCOME_EMAIL_TEMPLATE_ID=1
BREVO_ORDER_CONFIRMATION_TEMPLATE_ID=2
BREVO_SHIPMENT_NOTIFICATION_TEMPLATE_ID=3
BREVO_PAYMENT_FAILURE_TEMPLATE_ID=4
BREVO_CONTACT_US_TEMPLATE_ID=5

# Hangfire Background Jobs
HANGFIRE_ENABLED=true
HANGFIRE_WORKER_COUNT=16
HANGFIRE_QUEUES=default,webhooks,scheduled
HANGFIRE_SUCCESS_JOB_EXPIRY_MINUTES=60
HANGFIRE_FAILED_JOB_EXPIRY_DAYS=7

# Application Settings
APPLICATION_INSTANCE_ID=${PRODUCTION_INSTANCE_ID}
MAX_UPLOAD_SIZE_MB=100
SESSION_TIMEOUT_MINUTES=30
PAGINATION_DEFAULT_PAGE_SIZE=20
PAGINATION_MAX_PAGE_SIZE=100

# Tenant Settings
TENANT_TRIAL_DURATION_DAYS=14
TENANT_MAX_USERS_STARTER=5
TENANT_MAX_USERS_PROFESSIONAL=50
TENANT_MAX_PRODUCTS_STARTER=100
TENANT_MAX_PRODUCTS_PROFESSIONAL=1000
TENANT_MAX_API_CALLS_STARTER=10000
TENANT_MAX_API_CALLS_PROFESSIONAL=100000
TENANT_RESERVED_SUBDOMAINS=api,echoroom,mallu-masala,spinema,flowapi,flow,storeapi,store,admin,www,mail,ftp,cdn,static,assets

# Subscription Plans
SUBSCRIPTION_PLAN_STARTER_PRICE=0
SUBSCRIPTION_PLAN_PROFESSIONAL_PRICE=799
SUBSCRIPTION_PLAN_ENTERPRISE_PRICE=2499
SUBSCRIPTION_PLAN_CURRENCY=INR

# External Services
EXTERNAL_SERVICE_TIMEOUT_SECONDS=30
EXTERNAL_SERVICE_MAX_RETRIES=4
EXTERNAL_SERVICE_RETRY_DELAYS_MS=[100,1000,10000,30000]
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_SECONDS=30

# Monitoring (Application Insights) - Production
MONITORING_ENABLED=false
MONITORING_INSTRUMENTATION_KEY=
MONITORING_LOG_LEVEL=Warning
MONITORING_RESPONSE_TIME_THRESHOLD_MS=500
MONITORING_DB_QUERY_THRESHOLD_MS=100
